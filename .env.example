# Copy this file to `.env` (already git-ignored) and fill in real values for
# local development. In CI/CD (GitHub Actions, GitLab CI), don't use a .env
# file at all — set the same variable names as encrypted repo/org secrets
# and inject them as job-level environment variables instead; see the notes
# at the bottom of this file. Nothing in this package reads a secret any
# other way: standard_quant_tools.config.load_env() loads `.env` into
# os.environ once per process (never overriding a real env var that's
# already set), and every provider reads its config from os.environ.

# ── Bloomberg (standard_quant_tools.data.bloomberg_provider) ─────────────────
# Desktop API (DAPI) has NO separate API key/secret — it authenticates via a
# running, logged-in Bloomberg Terminal on this machine. These two variables
# only matter if you're proxying DAPI to a non-default address; the DAPI
# default (a Terminal on this same machine) needs neither set.
SQT_BLOOMBERG_HOST=localhost
SQT_BLOOMBERG_PORT=8194

# ── Polygon.io (standard_quant_tools.data.polygon_provider) ──────────────────
# Plain REST API — no SDK to install, just an API key. Get a free key at
# https://polygon.io/dashboard/api-keys. Required for source="polygon"; there
# is no default.
SQT_POLYGON_API_KEY=

# ── Cache / audit / artifact storage locations (optional overrides) ──────────
# Uncomment to override the defaults (~/.cache/standard_quant_tools/...).
# SQT_CACHE_DIR=
# SQT_AUDIT_DIR=
# SQT_RUNS_DIR=
# SQT_AUDIT_ENABLED=1

# ── Modeling runtime (standard_quant_tools.modeling) ─────────────────────────
# How many universe symbols build_model_dataset fetches at once. Default 8 —
# enough to matter on a large universe, low enough not to look like abuse to
# a public endpoint. Raise it for a provider you have a paid quota with; an
# unusable value falls back to the default rather than failing the fetch.
# SQT_MODELING_FETCH_CONCURRENCY=8

# -----------------------------------------------------------------------------
# CI/CD secrets (GitHub Actions / GitLab CI)
# -----------------------------------------------------------------------------
# GitHub Actions: Settings -> Secrets and variables -> Actions, then in the
# workflow:
#   env:
#     SQT_BLOOMBERG_HOST: ${{ secrets.SQT_BLOOMBERG_HOST }}
#     SQT_BLOOMBERG_PORT: ${{ secrets.SQT_BLOOMBERG_PORT }}
#     SQT_POLYGON_API_KEY: ${{ secrets.SQT_POLYGON_API_KEY }}
#
# GitLab CI: Settings -> CI/CD -> Variables (mark as "Protected"/"Masked"),
# then they're already exposed as environment variables to every job with no
# extra `env:` block needed — reference them directly, e.g. $SQT_BLOOMBERG_HOST.
#
# Either way, `standard_quant_tools.config.load_env()` is a no-op when no
# `.env` file exists (the normal CI state) and never overrides a real env
# var, so provider code needs no CI-specific branching.
